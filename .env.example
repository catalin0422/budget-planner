# Copiaza fisierul asta in .env.local si completeaza valorile.
# .env.local nu se commituie niciodata (e in .gitignore).

# ---------------------------------------------------------------------------
# Baza de date (Supabase Postgres)
# ---------------------------------------------------------------------------
# Supabase Dashboard > butonul "Connect" > tab-ul "Transaction pooler".
# ATENTIE: foloseste portul 6543 (transaction mode), nu 5432. Transaction mode e
# cel potrivit pentru functii serverless, care deschid multe conexiuni scurte.
DATABASE_URL=postgresql://postgres.PROIECT:PAROLA@aws-0-REGIUNE.pooler.supabase.com:6543/postgres

# Seteaza pe 1 doar daca primesti eroarea "self-signed certificate in certificate chain".
# DATABASE_SSL_NO_VERIFY=1

# ---------------------------------------------------------------------------
# Autentificare (Clerk)
# ---------------------------------------------------------------------------
# Clerk Dashboard > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
